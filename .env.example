# Public-safe configuration. Copy to .env.local; never commit real credentials.
# Use the project API URL: https://PROJECT_REF.supabase.co, not db.PROJECT_REF.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...) or legacy public anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REGION=IN
# Server-only TMDB API Read Access Token, not the API key.
TMDB_READ_ACCESS_TOKEN=
# Required for persistent provider snapshots and editor refresh in the full V1 setup.
# Base browsing still works without it; this key remains server-only.
# Supabase secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Test project only; never point integration tests at production.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
# Optional live editor E2E, against a dedicated test project only.
# E2E_TEST_PROJECT=1
# E2E_EDITOR_EMAIL=
# E2E_EDITOR_PASSWORD=
